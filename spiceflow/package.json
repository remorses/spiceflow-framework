{
  "name": "spiceflow",
  "version": "1.26.0-rsc.17",
  "description": "Simple API framework with RPC and type safety",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": "https://github.com/remorses/spiceflow",
  "imports": {
    "#load-global-css": {
      "react-server": "./dist/load-global-css.rsc.js",
      "default": "./dist/load-global-css.js"
    },
    "#rsc-runtime": {
      "spiceflow-vitest": "./dist/rsc-runtime.vitest.js",
      "react-server": "./dist/rsc-runtime.js",
      "default": "./dist/rsc-runtime.default.js"
    },
    "#deployment-id": {
      "types": "./dist/react/deployment-id.d.ts",
      "react-server": "./dist/react/deployment-id.rsc.js",
      "default": "./dist/react/deployment-id.js"
    },
    "#spiceflow-dirs": {
      "types": "./dist/react/spiceflow-dirs.d.ts",
      "workerd": "./dist/react/spiceflow-dirs.js",
      "react-server": "./dist/react/spiceflow-dirs.rsc.js",
      "default": "./dist/react/spiceflow-dirs.js"
    },
    "#handle-ssr": {
      "types": "./dist/react/handle-ssr.d.ts",
      "react-server": "./dist/react/handle-ssr.rsc.js",
      "default": "./dist/react/handle-ssr.js"
    },
    "#flight-data-context": {
      "types": "./dist/react/flight-data-context.d.ts",
      "react-server": "./dist/react/flight-data-context.rsc.js",
      "default": "./dist/react/flight-data-context.js"
    },
    "#router-context": {
      "types": "./dist/router-context.default.d.ts",
      "ssr": "./dist/router-context.js",
      "react-server": "./dist/router-context.js",
      "browser": "./dist/router-context.default.js",
      "bun": "./dist/router-context.js",
      "node": "./dist/router-context.js",
      "default": "./dist/router-context.default.js"
    },
    "#wait-until": {
      "workerd": "./dist/wait-until.workerd.js",
      "default": "./dist/wait-until.js"
    },
    "#cloudflare-tracer": {
      "workerd": "./dist/cloudflare-tracer.workerd.js",
      "default": "./dist/cloudflare-tracer.js"
    },
    "#node-server": {
      "types": "./dist/_node-server.d.ts",
      "bun": "./dist/_node-server.js",
      "workerd": "./dist/_node-server-unsupported.js",
      "edge-light": "./dist/_node-server-unsupported.js",
      "netlify": "./dist/_node-server-unsupported.js",
      "fastly": "./dist/_node-server-unsupported.js",
      "edge-routine": "./dist/_node-server-unsupported.js",
      "azion": "./dist/_node-server-unsupported.js",
      "lagon": "./dist/_node-server-unsupported.js",
      "wasmer": "./dist/_node-server-unsupported.js",
      "arvancloud": "./dist/_node-server-unsupported.js",
      "node": "./dist/_node-server.js",
      "deno": "./dist/_node-server.js",
      "default": "./dist/_node-server-unsupported.js"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.js",
      "workerd": "./dist/index.js",
      "node": "./dist/index.js",
      "bun": "./dist/index.js",
      "deno": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "ssr": "./dist/index.client.js",
      "browser": "./dist/index.client.js",
      "default": "./dist/index.js"
    },
    "./cors": {
      "types": "./dist/cors.d.ts",
      "default": "./dist/cors.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "workerd": "./dist/cloudflare.js",
      "default": "./dist/cloudflare.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "react-server": "./dist/react/index.rsc.js",
      "default": "./dist/react/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./federation": {
      "types": "./dist/federation.rsc.d.ts",
      "react-server": "./dist/federation.rsc.js",
      "default": "./dist/federation.default.js"
    },
    "./federation-client": {
      "types": "./dist/react/federation-client.d.ts",
      "default": "./dist/react/federation-client.js"
    },
    "./src/*": {
      "default": "./src/*.ts"
    },
    "./cloudflare-entrypoint": {
      "types": "./dist/react/entry.rsc.d.ts",
      "react-server": "./dist/react/entry.rsc.js",
      "workerd": "./dist/react/entry.rsc.js",
      "worker": "./dist/react/entry.rsc.js",
      "import": "./dist/react/entry.rsc.js",
      "default": "./dist/react/entry.rsc.js"
    },
    "./hono": {
      "types": "./dist/hono-adapter.d.ts",
      "default": "./dist/hono-adapter.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build-flight-client": "tsx scripts/build-flight-client.ts",
    "build": "echo '<!-- DO NOT EDIT: This file is auto-generated from root README.md -->' > ./README.md && echo '' >> ./README.md && cat ../README.md >> ./README.md && pnpm build-flight-client && pnpm tsc && pnpm check-entry",
    "prepublishOnly": "rimraf dist \"*.tsbuildinfo\" && pnpm build",
    "typecheck": "pnpm build",
    "gen-openapi": "pnpm tsx scripts/openapi-fern.ts",
    "docs:dev": "pnpm run gen-openapi && fern docs dev",
    "docs:prod": "pnpm run gen-openapi && fern generate --docs --force",
    "fern-sdk": "pnpm run gen-openapi && fern generate --force ",
    "fern-docs": "pnpm run gen-openapi && fern generate --docs --force",
    "play-sdk:build": "pnpm vite build --config ./scripts/play-sdk.vite.ts",
    "check-entry": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=/dev/null",
    "test": "pnpm build-flight-client && pnpm tsc && pnpm vitest",
    "lint": "lintcn lint --fix",
    "prepare": "# pnpm build",
    "watch": "tsc -w"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [],
  "author": "Tommaso De Rossi, morse <beats.by.morse@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.27",
    "eventsource-parser": "^3.0.2",
    "its-fine": "^2.0.0",
    "nf3": "0.3.16"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "*",
    "react": "*",
    "react-dom": "*",
    "hono": "^4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/node": "~24.0.1",
    "@types/ps-tree": "^1.1.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "ai": "^5.0.14",
    "esbuild": "^0.27.4",
    "hono": "^4.12.0",
    "react-server-dom-webpack": "19.2.4",
    "eventsource": "^3.0.5",
    "formdata-node": "^6.0.3",
    "js-base64": "^3.7.7",
    "js-yaml": "^4.1.0",
    "ps-tree": "^1.2.0",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.3",
    "superjson": "^2.2.2",
    "vite": "^8.0.13",
    "zod": "^4.3.6"
  }
}
