{
  "name": "spiceflow-root",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm run -r test",
    "watch": "pnpm -r watch",
    "build": "pnpm -r build",
    "release": "pnpm build && changeset",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/bun": "~1.2.13",
    "@types/node": "~24.0.1",
    "c8": "^10.1.3",
    "lintcn": "0.7.0",
    "prettier": "^3.4.2",
    "spiceflow": "workspace:^",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "spiceflow": "workspace:^",
      "@types/react": "19.2.16",
      "@types/react-dom": "19.2.3",
      "react": "19.2.8",
      "react-dom": "19.2.8"
    }
  },
  "repository": "https://github.com/remorses/",
  "author": "remorses <beats.by.morse@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "./*",
    "./experiments/*",
    "./example-federation/*"
  ]
}
